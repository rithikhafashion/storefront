<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Storefront</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <h1>Rithikha Fashion</h1>

  <div class="product-grid">
  {% for product in collections.products %}
    <div class="product-card">
      <img src="{{ product.data.image }}" alt="{{ product.data.title }}" onclick="showImage('{{ product.data.image }}')">
      <h2>{{ product.data.title }}</h2>
      <p>{{ product.data.price }}</p>
    </div>
  {% endfor %}
</div>

<!-- Image Modal -->
<div id="imageModal" class="modal" onclick="hideImage()">
  <span class="close">&times;</span>
  <img class="modal-content" id="modalImg">
</div>


</body>
</html>

<script>
function showImage(src) {
  document.getElementById('imageModal').style.display = 'flex';
  document.getElementById('modalImg').src = src;
}

function hideImage() {
  document.getElementById('imageModal').style.display = 'none';
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') hideImage();
});

</script>
