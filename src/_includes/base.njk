<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Rithikha Fashion - Elegant women\'s wear collection including sarees, kurthis, and nighties. Discover timeless beauty and affordable luxury.' }}">
  <meta name="keywords" content="sarees, kurthis, nighties, women's wear, fashion, traditional wear, Indian fashion">
  <meta name="author" content="Rithikha Fashion">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="{{ title or 'Rithikha Fashion' }}">
  <meta property="og:description" content="{{ description or 'Elegant women\'s wear collection' }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ page.url | url }}">
  
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  
  <title>{{ title or "Rithikha Fashion - Elegant Women's Wear Collection" }}</title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Dancing+Script:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Custom Styles -->
  <link rel="stylesheet" href="{{ '/styles/main.css' | url }}">
  
  {%- block head -%}{% endblock head %}
</head>
<body>
  <!-- HEADER -->
  <header>
    <nav class="nav-container">
      <div class="logo">
        <i class="fas fa-tshirt"></i>
        Rithikha Fashion
      </div>

      <!-- Hamburger Menu -->
      <div class="menu-toggle" id="menu-toggle">
        <i class="fas fa-bars"></i>
      </div>

      <div class="nav-menu" id="nav-menu">
        <a href="/" class="nav-link">
          <i class="fas fa-home"></i>
          Home
        </a>
        <div class="nav-item">
          <a href="#women" class="nav-link">
            <i class="fas fa-female"></i>
            Women
          </a>
          <div class="dropdown">
            <a href="{{ '/saree/' | url }}">
              <i class="fas fa-scarf"></i>
              Sarees
            </a>
            <a href="{{ '/kurthi/' | url }}">
              <i class="fas fa-tshirt"></i>
              Kurthis
            </a>
            <a href="{{ '/nighties/' | url }}">
              <i class="fas fa-moon"></i>
              Nighties
            </a>
          </div>
        </div>
        <a href="/#about" class="nav-link">
          <i class="fas fa-info-circle"></i>
          About
        </a>
        <a href="/#contact" class="nav-link">
          <i class="fas fa-envelope"></i>
          Contact
        </a>
      </div>
    </nav>
  </header>

  <!-- PAGE CONTENT -->
  <main>
    {{ content | safe }}
  </main>

  <!-- FOOTER -->
  <footer id="contact">
    <div class="footer-content">
      <div class="footer-section">
        <h3>
          <i class="fas fa-store"></i>
          About Us
        </h3>
        <p>Rithikha Fashion is SanKagiri's one-stop destination for elegant, affordable women's wear—from designer sarees to everyday essentials. We bring you the finest collection with quality and style.</p>
      </div>
      <div class="footer-section">
        <h3>
          <i class="fas fa-link"></i>
          Quick Links
        </h3>
        <ul>
          <li><a href="#women"><i class="fas fa-chevron-right"></i> Women's Collection</a></li>
          <li><a href="/saree/"><i class="fas fa-chevron-right"></i> Sarees</a></li>
          <li><a href="/kurthi/"><i class="fas fa-chevron-right"></i> Kurthis</a></li>
          <li><a href="/nighties/"><i class="fas fa-chevron-right"></i> Nighties</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>
          <i class="fas fa-address-card"></i>
          Contact Us
        </h3>
        <ul>
          <li>
            <i class="fas fa-envelope"></i>
            <a href="mailto:rithikhafashion@gmail.com">rithikhafashion@gmail.com</a>
          </li>
          <li>
            <i class="fas fa-phone"></i>
            <a href="tel:+918903299373">+91 89032 99373</a>
          </li>
          <li>
            <i class="fas fa-map-marker-alt"></i>
            Near New Bus Stand, Akkammapettai, SanKagiri, Tamil Nadu 637301
          </li>
        </ul>
        <div class="social-icons">
          <a href="#" aria-label="Facebook">
            <i class="fab fa-facebook-f"></i>
          </a>
          <a href="#" aria-label="Instagram">
            <i class="fab fa-instagram"></i>
          </a>
          <a href="#" aria-label="WhatsApp">
            <i class="fab fa-whatsapp"></i>
          </a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2024 Rithikha Fashion. All rights reserved.</p>
    </div>
  </footer>

  <!-- JavaScript -->
  <script src="{{ '/scripts/main.js' | url }}"></script>
</body>
</html>
