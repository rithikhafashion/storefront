<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <a href="/">← Back to Store</a>

  <div class="product-detail">
    <img src="{{ image }}" alt="{{ title }}">
    <h1>{{ title }}</h1>
    <p><strong>Price:</strong> {{ price }}</p>
    <p>{{ description }}</p>
  </div>
</body>
</html>
