<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Rithikha Fashion" }}</title>
  <link rel="stylesheet" href="{{ '/styles/main.css' | url }}">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://kit.fontawesome.com/your-fontawesome-kit.js" crossorigin="anonymous"></script>
  {%- block head -%}{% endblock head %}
<body>
  <!-- HEADER -->
  <header>
    <nav class="nav-container">
      <div class="logo">Rithikha Fashion</div>

      <!-- Hamburger Menu -->
      <div class="menu-toggle" id="menu-toggle">
        <i class="fas fa-bars"></i>
      </div>

      <div class="nav-menu" id="nav-menu">
        <a href="/">Home</a>
        <div class="nav-item">
          <a href="#women">Women</a>
          <div class="dropdown">
            <a href="{{ '/saree/' | url }}">Sarees</a>
            <a href="{{ '/kurthi/' | url }}">Kurthis</a>
            <a href="{{ '/nighties/' | url }}">Nighties</a>
          </div>
        </div>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </div>
    </nav>
  </header>

  <!-- PAGE CONTENT -->
  <main>
    {{ content | safe }}
  </main>

  <!-- FOOTER -->
  <footer>
    <div class="footer-content">
      <div class="footer-section">
        <h3>About Us</h3>
        <p>Rithikha Fashion is SanKagiri's one-stop destination for elegant, affordable women's wear—from designer sarees to everyday essentials.</p>
      </div>
      <div class="footer-section">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="#women">Women</a></li>
          <li><a href="#new-arrivals">New Arrivals</a></li>
          <li><a href="#best-sellers">Best Sellers</a></li>
          <li><a href="#offers">Special Offers</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h3>Contact Us</h3>
        <ul>
          <li>Email: rithikhafashion@gmail.com</li>
          <li>Phone: +91 89032 99373</li>
          <li>Address: Near New Bus Stand, Akkammapettai, SanKagiri, Tamil Nadu 637301</li>
        </ul>
        <div class="social-icons">
          <a href="#"><i class="fab fa-facebook-f"></i></a>
          <a href="#"><i class="fab fa-instagram"></i></a>
          <a href="#"><i class="fab fa-whatsapp"></i></a>
        </div>
      </div>
    </div>
  </footer>

  <!-- JS -->
  <script src="{{ '/scripts/main.js' | url }}"></script>
</body>
</html>
